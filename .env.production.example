# Production Environment Variables for Vercel Deployment
# Copy these to your Vercel project's environment variables
# DO NOT commit actual values - use Vercel's encrypted environment variables

# Site Configuration
NODE_ENV="production"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_BASE_URL="https://yourdomain.com"

# API Endpoints
EFP_API_URL=https://data.ethfollow.xyz/api/v1
NEXT_PUBLIC_EFP_API_URL=https://data.ethfollow.xyz/api/v1

# ENS Subgraph API Key
NEXT_PUBLIC_ENS_SUBGRAPH_API_KEY="your-ens-subgraph-api-key"

# Telemetry
NEXT_TELEMETRY_DISABLED=1

# WalletConnect Project ID (REQUIRED)
# Get your project ID at: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID="your-walletconnect-project-id"

# Push Notification VAPID Keys (REQUIRED for push notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Redis URL (REQUIRED for caching)
# Use Vercel KV: https://vercel.com/docs/storage/vercel-kv
# Or Upstash Redis: https://upstash.com/
REDIS_URL="your-redis-connection-string"

# Blockchain RPC Providers
NEXT_PUBLIC_QUICKNODE_ID="your-quicknode-id"
NEXT_PUBLIC_MAINNET_ALCHEMY_ID="your-mainnet-alchemy-id"
NEXT_PUBLIC_BASE_ALCHEMY_ID="your-base-alchemy-id"
NEXT_PUBLIC_OPTIMISM_ALCHEMY_ID="your-optimism-alchemy-id"

# Sentry Error Tracking (Optional)
SENTRY_DISABLED=false
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Performance Monitoring
NEXT_PUBLIC_REPORT_WEB_VITALS=true

# Smart Contract Addresses (Production)
NEXT_PUBLIC_EFP_ACCOUNT_METADATA=0x5289fE5daBC021D02FDDf23d4a4DF96F4E0F17EF
NEXT_PUBLIC_EFP_LIST_REGISTRY=0x0E688f5DCa4a0a4729946ACbC44C792341714e08
NEXT_PUBLIC_EFP_LIST_RECORDS=0x41Aa48Ef3c0446b46a5b1cc6337FF3d3716E2A33
NEXT_PUBLIC_EFP_LIST_MINTER=0xDb17Bfc64aBf7B7F080a49f0Bbbf799dDbb48Ce5

NEXT_PUBLIC_EFP_LIST_RECORDS_OP=0x4Ca00413d850DcFa3516E14d21DAE2772F2aCb85
NEXT_PUBLIC_EFP_LIST_RECORDS_MAINNET=0x5289fE5daBC021D02FDDf23d4a4DF96F4E0F17EF

# Rate Limits
NEXT_PUBLIC_MAINNET_LIMIT=500
NEXT_PUBLIC_OPTIMISM_LIMIT=500
NEXT_PUBLIC_BASE_LIMIT=1000
